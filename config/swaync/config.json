{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-exclusive-zone": false,
  "layer-shell": true,
  "cssPriority": "user",
  "notification-window-width": 390,
  "control-center-width": 410,
  "control-center-margin-top": 62,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "notification-icon-size": 44,
  "notification-body-image-height": 160,
  "notification-body-image-width": 280,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-height": -1,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "hide-on-clear": false,
  "hide-on-action": true,
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Control centre",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰖩  Network",
          "command": "networkmanager_dmenu"
        },
        {
          "label": "󰂯  Bluetooth",
          "command": "blueman-manager"
        },
        {
          "label": "󰕾  Audio",
          "command": "~/.config/hypr/scripts/midnight.py audio"
        },
        {
          "label": "󰌾  Lock",
          "command": "~/.config/hypr/scripts/midnight.py lock"
        }
      ]
    },
    "mpris": {
      "autohide": true
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃟"
    },
    "notifications": {
      "vexpand": false
    }
  },
  "ignore-gtk-theme": true,
  "text-empty": "No notifications"
}
