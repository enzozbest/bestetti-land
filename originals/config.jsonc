{
  "layer": "top",
  "height": 42,
  "spacing": 5,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "custom/separator",
    "custom/browser",
    "custom/files",
    "custom/terminal",
    "custom/code"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "tray",
    "custom/gpu",
    "cpu",
    "memory",
    "temperature",
    "custom/separator2",
    "bluetooth",
    "pulseaudio",
    "backlight",
    "network",
    "battery",
    "clock",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "mpris": {
    "format": "{player_icon}  {title} - {artist}",
    "format-paused": "{player_icon}  {title} - {artist}  󰏤",
    "format-stopped": "",
    "player-icons": {
      "firefox": "",
      "spotify": "",
      "default": "🎵"
    },
    "max-length": 50,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip-format": "{title} by {artist} on {album} ({player})"
  },
  "custom/gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits 2>/dev/null | awk -F', ' '{printf \"󰢮  %s%% %s°C\", $1, $2}'",
    "interval": 5,
    "format": "{}",
    "tooltip-format": "NVIDIA GPU",
    "on-click": "hyprctl dispatch exec '[float; size 900 600]' 'kitty -e nvtop'"
  },
  "cpu": {
    "interval": 5,
    "format": "  {usage}%",
    "tooltip-format": "{usage}% CPU usage\n{avg_frequency:.2f} GHz",
    "on-click": "hyprctl dispatch exec '[float; size 900 600]' 'kitty -e htop'"
  },
  "memory": {
    "interval": 10,
    "format": "  {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G RAM\n{swapUsed:0.1f}G / {swapTotal:0.1f}G Swap",
    "on-click": "hyprctl dispatch exec '[float; size 900 600]' 'kitty -e htop'"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{temperatureC}°C"
  },
  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip-format": "Brightness: {percent}%"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "clock": {
    "format": "  {:%a %d %b  %H:%M}",
    "format-alt": "  {:%Y-%m-%d  %H:%M:%S}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "interval": 1,
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "today": "<span color='#f38ba8'><b>{}</b></span>",
        "weekdays": "<span color='#94e2d5'><b>{}</b></span>"
      }
    }
  },
  "battery": {
    "states": {
      "good": 80,
      "warning": 40,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-charging": "󰂄  {capacity}%",
    "format-full": "󰁹  Full",
    "tooltip-format": "{timeTo}\n{power:.1f}W\n{health}% health"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  Wired",
    "format-disconnected": "  Disconnected",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n {bandwidthUpBits}   {bandwidthDownBits}\n{ipaddr}",
    "tooltip-format-ethernet": "{ipaddr}\n {bandwidthUpBits}   {bandwidthDownBits}",
    "on-click": "hyprctl dispatch exec '[float; size 600 400]' 'kitty -e nmtui'"
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "  Muted",
    "format-icons": {
      "headphone": "",
      "headset": "󰋎",
      "default": ["", "", ""]
    },
    "tooltip-format": "{volume}% | {desc}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pwvucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager",
    "on-click-right": "blueman-sendto"
  },
  "custom/launcher": {
    "format": "",
    "on-click": "wofi --show drun",
    "tooltip": false
  },
  "custom/browser": {
    "format": "󰈹",
    "on-click": "firefox-developer-edition",
    "tooltip-format": "Firefox Developer Edition"
  },
  "custom/files": {
    "format": "󰉋",
    "on-click": "thunar",
    "tooltip-format": "Files"
  },
  "custom/terminal": {
    "format": "󰆍",
    "on-click": "kitty",
    "tooltip-format": "Kitty Terminal"
  },
  "custom/code": {
    "format": "󰨞",
    "on-click": "zeditor",
    "tooltip-format": "Zed Editor"
  },
  "custom/separator": {
    "format": "│",
    "tooltip": false
  },
  "custom/separator2": {
    "format": "│",
    "tooltip": false
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "systemctl poweroff",
    "on-click-right": "systemctl reboot",
    "on-click-middle": "systemctl suspend",
    "tooltip-format": "Left: Shutdown | Right: Reboot | Middle: Suspend"
  }
}
